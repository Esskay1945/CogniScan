{
  "name": "cogniscan",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "node --test tests/*.test.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/migrate.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/stack": "^6.0.0",
    "better-auth": "1.7.22",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "kysely": "0.29.8",
    "lucide-react-native": "^1.8.0",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "^4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.10"
